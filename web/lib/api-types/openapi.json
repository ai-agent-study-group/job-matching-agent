{
  "openapi": "3.1.0",
  "info": {
    "title": "job-matching-agent API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health check",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/profile": {
      "post": {
        "tags": [
          "profile"
        ],
        "summary": "Extract a profile from a resume",
        "description": "Extract experience, education, skills and languages from the resume.\n\nSend the resume in the `resume` form field, as plain text or as a PDF or DOCX file.\nA file with no extractable text is rejected with 422 and a one-sentence `detail`.",
        "operationId": "profile",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ProfileRequestDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile-Output"
                }
              }
            }
          },
          "413": {
            "description": "The resume file is larger than 5 MB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDTO"
                }
              }
            }
          },
          "415": {
            "description": "The resume file is not a PDF or DOCX",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDTO"
                }
              }
            }
          },
          "502": {
            "description": "The agent failed for another reason, such as an LLM error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDTO"
                },
                "example": {
                  "detail": "Profile extraction failed. The agent failed for another reason, such as an LLM error"
                }
              }
            }
          },
          "503": {
            "description": "The LLM is rate limited or overloaded. Try again later",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDTO"
                },
                "example": {
                  "detail": "Profile extraction failed. The LLM is rate limited or overloaded. Try again later"
                }
              }
            }
          },
          "504": {
            "description": "The LLM did not respond in time. Try again later",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDTO"
                },
                "example": {
                  "detail": "Profile extraction failed. The LLM did not respond in time. Try again later"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/search": {
      "post": {
        "tags": [
          "search"
        ],
        "summary": "Search job postings for a profile",
        "description": "Search the job sources through the MCP tools for postings that match the profile.\n\nPass the profile returned by /api/profile. Unknown fields are rejected with 422.",
        "operationId": "search",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Profile-Input"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/JobPosting"
                  },
                  "type": "array",
                  "title": "Response Search"
                }
              }
            }
          },
          "502": {
            "description": "The agent failed for another reason, such as an LLM error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDTO"
                },
                "example": {
                  "detail": "Job search failed. The agent failed for another reason, such as an LLM error"
                }
              }
            }
          },
          "503": {
            "description": "The LLM is rate limited or overloaded. Try again later",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDTO"
                },
                "example": {
                  "detail": "Job search failed. The LLM is rate limited or overloaded. Try again later"
                }
              }
            }
          },
          "504": {
            "description": "The LLM did not respond in time. Try again later",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDTO"
                },
                "example": {
                  "detail": "Job search failed. The LLM did not respond in time. Try again later"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Education": {
        "properties": {
          "degree": {
            "type": "string",
            "minLength": 1,
            "title": "Degree",
            "description": "Degree or vocational training as written, e.g. \"M.Sc.\", \"Ausbildung\"."
          },
          "subject": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subject"
          },
          "end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End",
            "description": "\"YYYY-MM\" or \"YYYY\". null if ongoing."
          }
        },
        "type": "object",
        "required": [
          "degree"
        ],
        "title": "Education"
      },
      "ErrorDTO": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "What failed"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorDTO",
        "description": "Error response body."
      },
      "Experience": {
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "company": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company"
          },
          "start": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start",
            "description": "\"YYYY-MM\" or \"YYYY\"."
          },
          "end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End",
            "description": "\"YYYY-MM\" or \"YYYY\". null if current."
          },
          "highlights": {
            "items": {
              "$ref": "#/components/schemas/Highlight"
            },
            "type": "array",
            "title": "Highlights"
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "Experience"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Highlight": {
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text",
            "description": "One bullet or line of a role, copied as written, including tech stack lines. Do not summarize or split."
          },
          "skills": {
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array",
            "title": "Skills",
            "description": "Tools, technologies and certificates named in this sentence, in their common official name."
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "Highlight"
      },
      "JobPosting": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source",
            "description": "Source of the posting, e.g. arbeitsagentur"
          },
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Posting id within the source"
          },
          "company": {
            "type": "string",
            "title": "Company",
            "description": "Company name"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Job title"
          },
          "location": {
            "type": "string",
            "title": "Location",
            "description": "Location as written by the source"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url",
            "description": "Posting page URL; only set when a single posting is fetched"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "description": "Posting body as plain text; only set when a single posting is fetched"
          }
        },
        "type": "object",
        "required": [
          "source",
          "id",
          "company",
          "title",
          "location",
          "url",
          "description"
        ],
        "title": "JobPosting",
        "description": "A job posting from a source, converted to our common format."
      },
      "Language": {
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "title": "Code",
            "description": "ISO 639-1 code, e.g. \"de\", \"en\"."
          },
          "level": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "basic",
                  "good",
                  "fluent",
                  "native"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Level",
            "description": "null if no level is stated."
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "Language"
      },
      "Profile-Input": {
        "properties": {
          "seniority": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "intern",
                  "junior",
                  "mid",
                  "senior",
                  "lead"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Seniority",
            "description": "Career level. null if unclear."
          },
          "languages": {
            "items": {
              "$ref": "#/components/schemas/Language"
            },
            "type": "array",
            "title": "Languages",
            "description": "Only languages explicitly stated."
          },
          "experiences": {
            "items": {
              "$ref": "#/components/schemas/Experience"
            },
            "type": "array",
            "title": "Experiences"
          },
          "educations": {
            "items": {
              "$ref": "#/components/schemas/Education"
            },
            "type": "array",
            "title": "Educations"
          },
          "other_skills": {
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array",
            "title": "Other Skills",
            "description": "Skills listed outside any role, e.g. a Skills section."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Profile"
      },
      "Profile-Output": {
        "properties": {
          "seniority": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "intern",
                  "junior",
                  "mid",
                  "senior",
                  "lead"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Seniority",
            "description": "Career level. null if unclear."
          },
          "languages": {
            "items": {
              "$ref": "#/components/schemas/Language"
            },
            "type": "array",
            "title": "Languages",
            "description": "Only languages explicitly stated."
          },
          "experiences": {
            "items": {
              "$ref": "#/components/schemas/Experience"
            },
            "type": "array",
            "title": "Experiences"
          },
          "educations": {
            "items": {
              "$ref": "#/components/schemas/Education"
            },
            "type": "array",
            "title": "Educations"
          },
          "other_skills": {
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array",
            "title": "Other Skills",
            "description": "Skills listed outside any role, e.g. a Skills section."
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Skills",
            "readOnly": true
          },
          "months_of_experience": {
            "type": "integer",
            "title": "Months Of Experience",
            "readOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "seniority",
          "languages",
          "experiences",
          "educations",
          "other_skills",
          "skills",
          "months_of_experience"
        ],
        "title": "Profile"
      },
      "ProfileRequestDTO": {
        "properties": {
          "resume": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ],
            "title": "Resume",
            "description": "Resume as a PDF or DOCX file, or as plain text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "resume"
        ],
        "title": "ProfileRequestDTO",
        "description": "Form body for extracting a profile from a resume."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
