{
  "openapi": "3.1.0",
  "info": {
    "title": "job-matching-agent API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health check",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/profile": {
      "post": {
        "tags": [
          "profile"
        ],
        "summary": "Extract a profile from a resume",
        "description": "Extract job titles and preferred work locations from the resume text.",
        "operationId": "profile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileRequestDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile-Output"
                }
              }
            }
          },
          "502": {
            "description": "The agent failed for another reason, such as an LLM error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDTO"
                },
                "example": {
                  "detail": "Profile extraction failed. The agent failed for another reason, such as an LLM error"
                }
              }
            }
          },
          "503": {
            "description": "The LLM is rate limited or overloaded. Try again later",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDTO"
                },
                "example": {
                  "detail": "Profile extraction failed. The LLM is rate limited or overloaded. Try again later"
                }
              }
            }
          },
          "504": {
            "description": "The LLM did not respond in time. Try again later",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDTO"
                },
                "example": {
                  "detail": "Profile extraction failed. The LLM did not respond in time. Try again later"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/search": {
      "post": {
        "tags": [
          "search"
        ],
        "summary": "Search job postings for a profile",
        "description": "Search the job sources through the MCP tools for postings that match the profile.\n\nPass the profile returned by /api/profile, edited by the user if needed.",
        "operationId": "search",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Profile-Input"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/JobPosting"
                  },
                  "type": "array",
                  "title": "Response Search"
                }
              }
            }
          },
          "502": {
            "description": "The agent failed for another reason, such as an LLM error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDTO"
                },
                "example": {
                  "detail": "Job search failed. The agent failed for another reason, such as an LLM error"
                }
              }
            }
          },
          "503": {
            "description": "The LLM is rate limited or overloaded. Try again later",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDTO"
                },
                "example": {
                  "detail": "Job search failed. The LLM is rate limited or overloaded. Try again later"
                }
              }
            }
          },
          "504": {
            "description": "The LLM did not respond in time. Try again later",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDTO"
                },
                "example": {
                  "detail": "Job search failed. The LLM did not respond in time. Try again later"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorDTO": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "What failed"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorDTO",
        "description": "Error response body."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobPosting": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source",
            "description": "Source of the posting, e.g. arbeitsagentur"
          },
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Posting id within the source"
          },
          "company": {
            "type": "string",
            "title": "Company",
            "description": "Company name"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Job title"
          },
          "location": {
            "type": "string",
            "title": "Location",
            "description": "Location as written by the source"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url",
            "description": "Posting page URL; only set when a single posting is fetched"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "description": "Posting body as plain text; only set when a single posting is fetched"
          }
        },
        "type": "object",
        "required": [
          "source",
          "id",
          "company",
          "title",
          "location",
          "url",
          "description"
        ],
        "title": "JobPosting",
        "description": "A job posting from a source, converted to our common format."
      },
      "Profile-Input": {
        "properties": {
          "job_titles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Job Titles",
            "description": "Relevant job titles based on the candidate's experience and skills. Use titles commonly found in job postings."
          },
          "locations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Locations",
            "description": "Preferred work locations explicitly stated in the resume. Do not infer preferences from the current address. Return an empty list if unspecified."
          }
        },
        "type": "object",
        "title": "Profile",
        "description": "Profile information extracted from a candidate's resume."
      },
      "Profile-Output": {
        "properties": {
          "job_titles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Job Titles",
            "description": "Relevant job titles based on the candidate's experience and skills. Use titles commonly found in job postings."
          },
          "locations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Locations",
            "description": "Preferred work locations explicitly stated in the resume. Do not infer preferences from the current address. Return an empty list if unspecified."
          }
        },
        "type": "object",
        "required": [
          "job_titles",
          "locations"
        ],
        "title": "Profile",
        "description": "Profile information extracted from a candidate's resume."
      },
      "ProfileRequestDTO": {
        "properties": {
          "resume_text": {
            "type": "string",
            "minLength": 1,
            "title": "Resume Text",
            "description": "Resume as plain text",
            "examples": [
              "Data analyst, 3 years of Python and SQL. Looking for a full-time job in Berlin."
            ]
          }
        },
        "type": "object",
        "required": [
          "resume_text"
        ],
        "title": "ProfileRequestDTO",
        "description": "Request body for extracting a profile from resume text."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
